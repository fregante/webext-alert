{
	"$schema": "https://json.schemastore.org/chrome-manifest",
	"name": "webext-alert",
	"description": "Live demo extension for the webext-alert package",
	"version": "0.0.0",
	"manifest_version": 3,
	"action": {
		"default_popup": "./unrelated-popup.html"
	},
	"background": {
		"service_worker": "./background.js",
		"scripts": [
			"./background.js"
		],
		"type": "module"
	}
}
