{
	"name": "webext-alert",
	"version": "2.0.2",
	"description": "alert() for background pages/workers in Web Extensions",
	"license": "MIT",
	"repository": "fregante/webext-alert",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		".": {
			"types": "./distribution/module/index.d.ts",
			"default": "./distribution/module/index.js"
		},
		"./page.html": "./distribution/web/index.html"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "vite build",
		"watch": "vite build --watch",
		"prepack": "npm run build",
		"test": "xo && tsc && npm run test:unit",
		"test:unit": "node --import ./test/register.js --test source/*.test.ts",
		"watch:typescript": "tsc --watch"
	},
	"files": [
		"distribution/module",
		"distribution/web"
	],
	"keywords": [
		"browser",
		"chrome",
		"safari",
		"extension",
		"alert",
		"popup",
		"background",
		"window",
		"prompt",
		"firefox",
		"webextension"
	],
	"dependencies": {
		"webext-detect": "^6.0.0",
		"webext-events": "^4.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.6",
		"@types/node": "^24.19.2",
		"globals": "^17.13.0",
		"typescript": "^6.0.3",
		"unplugin-dts": "^1.1.2",
		"vite": "^8.3.5",
		"vite-plugin-singlefile": "^2.3.4",
		"vite-plugin-static-copy": "^4.1.1",
		"webext-base-css": "^2.1.0",
		"xo": "^5.0.1"
	},
	"webExt": {
		"sourceDir": "distribution/demo"
	}
}
