{
	"name": "webext-alert",
	"version": "2.0.1",
	"description": "alert() for background pages/workers in Web Extensions",
	"license": "MIT",
	"repository": "fregante/webext-alert",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		".": {
			"types": "./distribution/index.d.ts",
			"default": "./distribution/index.js"
		},
		"./page.html": "./web/index.html"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "vite build",
		"demo:build": "vite build --config demo/vite.config.js",
		"demo:watch": "vite build --watch --config demo/vite.config.js",
		"prepare": "npm run build",
		"test": "xo && tsc",
		"watch": "tsc --watch"
	},
	"files": [
		"distribution",
		"web"
	],
	"keywords": [
		"browser",
		"chrome",
		"safari",
		"extension",
		"alert",
		"popup",
		"background",
		"window",
		"prompt",
		"firefox",
		"webextension"
	],
	"dependencies": {
		"webext-detect": "^6.0.0",
		"webext-events": "^4.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.6",
		"globals": "^17.13.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"webext-base-css": "^2.1.0",
		"xo": "^5.0.1"
	},
	"webExt": {
		"sourceDir": "demo/dist"
	}
}
