{
	"name": "webext-alert",
	"version": "1.1.0",
	"description": "alert() for background pages/workers in Web Extensions",
	"license": "MIT",
	"repository": "fregante/webext-alert",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": {
				"types": "./index.d.ts",
				"default": "./index.js"
			}
		},
		"./page.html": "./web/index.html"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "parcel build source/index.ts && tsc",
		"demo:build": "parcel build --no-cache",
		"demo:watch": "parcel watch --no-cache --no-hmr",
		"prepare": "npm run build",
		"test": "xo && tsc --noEmit",
		"watch": "tsc --watch"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"web"
	],
	"keywords": [
		"browser",
		"chrome",
		"safari",
		"extension",
		"alert",
		"popup",
		"background",
		"window",
		"prompt",
		"firefox",
		"webextension"
	],
	"dependencies": {
		"webext-detect": "^6.0.0",
		"webext-events": "^4.0.0"
	},
	"devDependencies": {
		"@parcel/config-webextension": "^2.16.4",
		"@parcel/packager-ts": "^2.16.4",
		"@parcel/transformer-inline-string": "^2.16.4",
		"@parcel/transformer-webextension": "^2.16.4",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.6",
		"globals": "^17.13.0",
		"parcel": "^2.16.4",
		"postcss-import": "^17.0.1",
		"typescript": "^6.0.3",
		"webext-base-css": "^2.1.0",
		"xo": "^5.0.1"
	},
	"source": "source/index.ts",
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"targets": {
		"main": false,
		"types": false,
		"module": {
			"isLibrary": true,
			"includeNodeModules": false,
			"outputFormat": "esmodule",
			"sourceMap": false
		},
		"demo": {
			"engines": {
				"browsers": "last 2 Chrome versions"
			},
			"source": "demo/manifest.json",
			"sourceMap": {
				"inline": true
			}
		}
	},
	"webExt": {
		"sourceDir": "dist"
	}
}
